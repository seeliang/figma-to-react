{
  "name": "figma-to-react-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "test": "vitest run",
    "typecheck": "tsc -b packages/core packages/emit-react packages/cli",
    "format": "prettier --write .",
    "verify": "pnpm build && pnpm typecheck && pnpm test && pnpm --filter figma-to-react-example build && node scripts/verify-styles.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
